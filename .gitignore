# 모델 가중치 — 절대 커밋하지 않는다 (수 GB)
models/
*.gguf

# 벤치 결과물 / 평가 이미지
bench/results/
data/images/

# 애플리케이션 런로그. 실행마다 쌓이고 재현 가능하다.
# 보존할 런은 app/runs/keep/ 로 옮긴다.
app/runs/*.jsonl

# 지도 API 로 받은 이미지는 커밋하지 않는다. 사업자 약관상 이미지 캐싱이
# 회색지대다 → app/docs/23-open-questions.md §2
app/runs/images/
# 라벨 이미지도 같은 이유. 라벨 대장(samples/labels.jsonl)은 커밋하고
# 이미지 바이트만 로컬에 둔다 — 재수집은 make_samples.py 로 재현 가능
app/labels/*/images/
app/labels/*/retired_v1_neg/
# 검수용으로 하드링크만 모아 둔 폴더 (원본은 app/labels/<ds>/images/)
app/labels/walk_only/
# 코스 SVG 는 OSM 타일이 base64 로 박혀 장당 1~2MB 다. plot_course.py 로 재생성
app/labels/*/svg/
app/labels/.tilecache/
# dry-run 산출물 — make_samples.py --dry-run 으로 재생성
app/labels/*/samples_dry.jsonl

# 비밀값 — 절대 커밋하지 않는다.
# 형식만 app/.env.example 에 남기고 값은 각자 로컬에 둔다.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# llama.cpp 소스/빌드 — 커밋하지 않는다 (소스 206MB + 빌드 174MB).
# 진실은 configs/llama.pin 의 커밋 해시이고,
# scripts/build-llama.sh 가 그 커밋으로 재현한다.
vendor/llama.cpp/

# macOS
.DS_Store

# 라벨 데이터 — 커밋하지 않는다. 이 저장소는 public 이고, 대장 자체는
# labels/ 의 수집 스크립트로 재현 가능하다 (→ app/docs/22-labels.md §5).
# 남기는 것은 "무엇을 어떻게 모았는가"(스크립트 + 문서)이지 모은 것이 아니다.
app/labels/trails.json
app/labels/*/*.json
app/labels/*/*.jsonl
app/labels/*/*.tsv
app/labels/*/routes/
# 예외: 사람이 손으로 넣은 좌표 보정. 어떤 스크립트로도 재생성되지 않는다
# (POI 검색이 안 되는 지점마다 사람의 판단과 근거가 적혀 있다).
!app/labels/*/overrides.json

# Claude Code 가 만드는 워크트리 체크아웃. 같은 저장소의 사본이다.
.claude/worktrees/

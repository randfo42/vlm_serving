# 모델 가중치 — 절대 커밋하지 않는다 (수 GB)
models/
*.gguf

# 벤치 결과물 / 평가 이미지
bench/results/
data/images/

# 애플리케이션 런로그. 실행마다 쌓이고 재현 가능하다.
# 보존할 런은 app/runs/keep/ 로 옮긴다.
app/runs/*.jsonl

# 지도 API 로 받은 이미지는 커밋하지 않는다. 사업자 약관상 이미지 캐싱이
# 회색지대다 → app/docs/23-open-questions.md §2
app/runs/images/

# 비밀값 — 절대 커밋하지 않는다.
# 형식만 app/.env.example 에 남기고 값은 각자 로컬에 둔다.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# llama.cpp 소스/빌드 — 커밋하지 않는다 (소스 206MB + 빌드 174MB).
# 진실은 configs/llama.pin 의 커밋 해시이고,
# scripts/build-llama.sh 가 그 커밋으로 재현한다.
vendor/llama.cpp/

# macOS
.DS_Store

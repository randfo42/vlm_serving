{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-reads.py\"",
            "statusMessage": "비밀값 접근 검사"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-on-commit.py\"",
            "statusMessage": "커밋 전 검사 (ruff · pytest · 리뷰 에이전트)",
            "timeout": 540
          }
        ]
      }
    ]
  }
}
